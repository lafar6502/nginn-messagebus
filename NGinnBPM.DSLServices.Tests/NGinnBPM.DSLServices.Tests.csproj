    </Reference>
    <Reference Include="Boo.Lang.Compiler">
      <HintPath>..\extlib\Boo.Lang.Compiler.dll</HintPath>
    </Reference>
    <Reference Include="Boo.Lang.Parser">
      <HintPath>..\extlib\Boo.Lang.Parser.dll</HintPath>
    </Reference>
